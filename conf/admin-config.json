{
  "listenAddr": ":8080",
  "publicUrl": "http://localhost:8080",
  "staticDir": "cmd/web/dist",
  "dataDir": "data",

  "agentRegistry": {
    "unhealthyAfter": "30s",
    "offlineAfter": "60s"
  },

  "task": {
    "maxFlowSizeMB": 10,
    "maxBinarySizeMB": 200,
    "maxMultipartSizeMB": 32,
    "deadlineDefault": "1h"
  },

  "upgrade": {
    "rolloutDelay": "5s",
    "perAgentTimeout": "5m"
  },

  "history": {
    "enabled": true,
    "samplerInterval": "10s",
    "retentionDays": 90,
    "pruneRunAt": "03:00",
    "mysql": {
      "dsn": "root:123456@tcp(192.168.8.219:3306)/jump-test?parseTime=true&loc=Local",
      "maxOpenConns": 10,
      "maxIdleConns": 5,
      "connMaxLifetime": "1h"
    }
  },

  "log": {
    "level": "info",
    "path": "log/admin.log",
    "maxSizeMB": 100,
    "maxBackups": 10
  }
}
