{
  "port": 8080,
  "publicUrl": "http://localhost:8080",
  "staticDir": "cmd/web/dist",
  "dataDir": "data",

  "agentRegistry": {
    "unhealthyAfter": "30s",
    "offlineAfter": "60s",
    "purgeAfter": "24h"
  },

  "task": {
    "maxMultipartSizeMB": 32,
    "deadlineDefault": "1h"
  },

  "history": {
    "enabled": true,
    "samplerInterval": "10s",
    "retentionDays": 90,
    "mysql": {
      "host": "192.168.8.219",
      "port": 3306,
      "user": "root",
      "password": "123456",
      "database": "jump-test",
      "maxOpenConns": 10,
      "maxIdleConns": 5,
      "connMaxLifetime": "1h"
    }
  },

  "log": {
    "level": "info",
    "path": "log/admin.log",
    "maxSizeMB": 100,
    "maxBackups": 10
  }
}
