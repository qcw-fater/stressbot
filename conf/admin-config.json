{
  "port": 7718,
  "publicUrl": "http://127.0.0.1:7718",

  "agentRegistry": {
    "unhealthyAfter": "30s",
    "offlineAfter": "60s"
  },

  "history": {
    "enabled": true,
    "retentionDays": 90,
    "mysql": {
      "host": "127.0.0.1",
      "port": 3306,
      "user": "root",
      "password": "123456",
      "database": "stressbot",
      "maxOpenConns": 10,
      "maxIdleConns": 5,
      "connMaxLifetime": "1h"
    }
  },

  "log": {
    "level": "info",
    "path": "log/admin.log",
    "maxSizeMB": 100,
    "maxBackups": 10
  },
  "daemon": false
}
