{
  "port": 7718,
  "publicUrl": "http://127.0.0.1:7718",

  "agentRegistry": {
    "unhealthyAfter": "30s",
    "offlineAfter": "60s"
  },

  "history": {
    "enabled": true,
    "retentionDays": 90,
    "mysql": {
      "host": "127.0.0.1",
      "port": 3306,
      "user": "root",
      "password": "123456",
      "database": "stressbot",
      "maxOpenConns": 10,
      "maxIdleConns": 5,
      "connMaxLifetime": "1h"
    }
  },

  "log": {
    "level": "info",
    "path": "log/admin.log",
    "maxSizeMB": 100,
    "maxBackups": 10
  },
  "pprof": {
    "enabled": false,
    "port": 6060
  },
  "shared": {
    "redis": {
      "addr": "127.0.0.1:6379",
      "username": "",
      "password": "",
      "db": 0,
      "keyPrefix": "stressbot",
      "defaultClaimTTL": "30s",
      "opTimeout": "2s",
      "poolSize": 0
    }
  },
  "daemon": false
}
