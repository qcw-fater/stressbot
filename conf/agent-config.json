{
  "log": {
    "path": "log/agent.log",
    "level": "info",
    "printConsole": true,
    "maxSizeMB": 100,
    "maxBackups": 5,
    "maxAge": 7,
    "localTime": true,
    "compress": true
  },
  "monitor": {
    "apdexThresholdMs": 100,
    "timingDetail": "rtt"
  },
  "pprof": { "port": 6060 },
  "agent": {
    "enabled": true,
    "adminUrl": "http://127.0.0.1:7720",
    "publicUrl": "http://127.0.0.1:7719",
    "port": 7719,
    "maxBots": 5000,
    "heartbeatInterval": "10s",
    "heartbeatTimeout": "5s",
    "heartbeatFailThreshold": 3,
    "requestTimeout": "30s",
    "reconnectMaxRetries": -1,
    "metricsInterval": "5s",
    "tls": {}
  },
  "daemon": false
}
