{
  "log": {
    "path": "log/agent.log",
    "level": "info",
    "printConsole": true,
    "maxSizeMB": 100,
    "maxBackups": 5,
    "maxAge": 7,
    "localTime": true,
    "compress": true
  },
  "monitor": {
    "apdexThresholdMs": 100,
    "timingDetail": "rtt"
  },
  "pprof": { "port": 6060 },
  "agent": {
    "enabled": true,
    "id": "agent-001",
    "adminAddress": "127.0.0.1:7720",
    "name": "agent-001",
    "maxBots": 5000,
    "heartbeatInterval": "10s",
    "reconnectMaxRetries": -1,
    "metricsInterval": "5s"
  },
  "daemon": false
}
