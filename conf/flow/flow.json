      "pattern": "tcpRequest",
      "service": "logic",
      "route": {
        "cmd": 1,
        "act": 1
      },
      "c2sProto": "Game.LoginPlayerC2S",
      "s2cProto": "Game.LoginPlayerS2C",
      "bindings": [
        {
          "type": "state",
          "field": "playerId",
          "source": "roleId"
        },
        {
          "type": "state",
          "field": "session",
          "source": "session"
        },
        {
          "type": "state",
          "field": "version",
          "source": "version"
        },
        {
          "type": "state",
          "field": "battleVersion",
          "source": "battleVersion"
        },
        {
          "type": "state",
          "field": "account",
          "source": "account"
        },
        {
          "type": "state",
          "field": "zoneId",
          "source": "zoneId"
        }
      ],
      "store": [
        {
          "setter": "loginResp"
        }
      ]
    },
