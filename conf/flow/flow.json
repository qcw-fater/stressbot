{
  "defaultDelayMs": 1000,
  "nodes": {
    "main": {
      "type": "sequence",
      "next": ["authLogin", "logicLogin", "gmCommands", "setLbs", "businessLoop"]
    },

    "authLogin": {
      "type": "sequence",
      "next": ["RequestZoneList", "RequestOutsideNotice", "RequestNotice", "PostLogin", "hasRole", "SelectRole"]
    },
    "RequestZoneList": { "type": "action", "action": "RequestZoneList", "breakOff": true },
    "RequestOutsideNotice": { "type": "action", "action": "RequestOutsideNotice" },
    "RequestNotice": { "type": "action", "action": "RequestNotice" },
    "PostLogin": { "type": "action", "action": "PostLogin", "breakOff": true },
    "hasRole": {
      "type": "boolean",
      "condition": "lua:check_role.lua",
      "falseNext": "createNewRole"
    },
    "createNewRole": { "type": "action", "action": "NewRole", "breakOff": true },
    "SelectRole": { "type": "action", "action": "SelectRole", "breakOff": true },

    "logicLogin": {
      "type": "sequence",
      "next": ["ConnectLogicTCP", "PlayerLogin", "RequestPlayerData", "ReportBattleDelay", "GetActivityList"]
    },
    "ConnectLogicTCP": {
      "type": "action",
      "action": "ConnectLogicTCP",
      "breakOff": true,
      "listenCallbacks": [
        {"route": {"cmd": 3, "act": 1}, "server": "tcp:logic", "callback": "matchPoll"},
        {"route": {"cmd": 5, "act": 20}, "server": "tcp:logic", "callback": "teamStartMatch"},
        {"route": {"cmd": 4, "act": 6}, "server": "tcp:logic", "callback": "loadingPoll"},
        {"route": {"cmd": 4, "act": 72}, "server": "tcp:logic", "callback": "rewardPoll"},
        {"route": {"cmd": 2, "act": 18}, "server": "tcp:logic", "callback": "stateUpdate"},
        {"route": {"cmd": 6, "act": 1}, "server": "tcp:logic", "callback": "heroUpdate"},
        {"route": {"cmd": 35, "act": 2}, "server": "tcp:logic", "callback": "shopDataUpdate"},
        {"route": {"cmd": 5, "act": 3}, "server": "tcp:logic", "callback": "teamUpdateInfo"},
        {"route": {"cmd": 5, "act": 6}, "server": "tcp:logic", "callback": "teamNotifyInvite"},
        {"route": {"cmd": 5, "act": 10}, "server": "tcp:logic", "callback": "teamJoin"},
        {"route": {"cmd": 21, "act": 15}, "server": "tcp:logic", "callback": "guildJoin"},
        {"route": {"cmd": 21, "act": 16}, "server": "tcp:logic", "callback": "guildKickMember"},
        {"route": {"cmd": 21, "act": 14}, "server": "tcp:logic", "callback": "guildMemberUpdate"},
        {"route": {"cmd": 21, "act": 13}, "server": "tcp:logic", "callback": "guildUpdate"},
        {"route": {"cmd": 3, "act": 5}, "server": "tcp:logic", "callback": "customRoomStart"},
        {"route": {"cmd": 14, "act": 10}, "server": "tcp:logic", "callback": "roomUpdateData"},
        {"route": {"cmd": 14, "act": 23}, "server": "tcp:logic", "callback": "roomUpdateStatus"},
        {"route": {"cmd": 1, "act": 2}, "server": "tcp:logic", "callback": null}
      ]
    },
    "PlayerLogin": { "type": "action", "action": "PlayerLogin", "breakOff": true },
    "RequestPlayerData": { "type": "action", "action": "RequestPlayerData" },
    "ReportBattleDelay": { "type": "action", "action": "ReportBattleDelay" },
    "GetActivityList": { "type": "action", "action": "GetActivityList" },

    "gmCommands": {
      "type": "sequence",
      "next": ["GMAddHero", "GMAddItem", "GMAddHeroCup", "GMFinishAllNewUserGuide"]
    },
    "GMAddHero": { "type": "action", "action": "GMAddHero" },
    "GMAddItem": { "type": "action", "action": "GMAddItem" },
    "GMAddHeroCup": { "type": "action", "action": "GMAddHeroCup" },
    "GMFinishAllNewUserGuide": { "type": "action", "action": "GMFinishAllNewUserGuide" },

    "setLbs": {
      "type": "sequence",
      "next": ["LbsPositioning"]
    },
    "LbsPositioning": { "type": "action", "action": "LbsPositioning" },

    "businessLoop": {
      "type": "loop",
      "loopCount": -1,
      "body": "businessWeight"
    },

    "businessWeight": {
      "type": "weighted",
      "options": [
        {"node": "normalModel", "weight": 40},
        {"node": "lobbyOperation", "weight": 12},
        {"node": "lottery", "weight": 10},
        {"node": "heroCultivate", "weight": 10},
        {"node": "shop", "weight": 8},
        {"node": "battlePass", "weight": 8},
        {"node": "friend", "weight": 6},
        {"node": "mail", "weight": 5},
        {"node": "giftCode", "weight": 1}
      ]
    },

    "normalModel": {
      "type": "sequence",
      "next": ["RequestGameModeList", "CreateNormalTeam", "SelectHero", "StartMatch", "MatchSucceed", "ListenStartLoading", "startBattle"]
    },
    "RequestGameModeList": { "type": "action", "action": "RequestGameModeList" },
    "CreateNormalTeam": { "type": "action", "action": "CreateNormalTeam" },
    "SelectHero": { "type": "action", "action": "SelectHero" },
    "StartMatch": { "type": "action", "action": "StartMatch" },
    "MatchSucceed": { "type": "action", "action": "MatchSucceed" },
    "ListenStartLoading": { "type": "action", "action": "ListenStartLoading" },

    "startBattle": {
      "type": "sequence",
      "next": ["ConnectBattleTCP", "ConnectBattleUDP", "RegisterBattle", "loadLoop", "BattleLoadOK", "ResetLoadState", "StartGame", "syncLoop", "BattleEnd", "BattleReward", "GameOver", "CleanupBattle"]
    },
    "ConnectBattleTCP": {
      "type": "action",
      "action": "ConnectBattleTCP",
      "listenCallbacks": [
        {"route": {"cmd": 4, "act": 10}, "server": "tcp:battle", "callback": null}
      ]
    },
    "ConnectBattleUDP": {
      "type": "action",
      "action": "ConnectBattleUDP",
      "listenCallbacks": [
        {"route": {"cmd": 4, "act": 11}, "server": "udp:battle", "callback": "frameData"}
      ]
    },
    "RegisterBattle": { "type": "action", "action": "RegisterBattle" },
    "loadLoop": {
      "type": "loop",
      "loopCount": -1,
      "breakCondition": "state:loadProgress>=100",
      "body": "LoadProgress"
    },
    "LoadProgress": { "type": "action", "action": "LoadProgress", "delayMs": -1 },
    "BattleLoadOK": { "type": "action", "action": "BattleLoadOK" },
    "ResetLoadState": { "type": "action", "action": "ResetLoadState" },
    "StartGame": { "type": "action", "action": "StartGame" },
    "syncLoop": {
      "type": "loop",
      "loopCount": 30,
      "body": "SyncFrameData"
    },
    "SyncFrameData": { "type": "action", "action": "SyncFrameData", "delayMs": -1 },
    "BattleEnd": { "type": "action", "action": "BattleEnd" },
    "BattleReward": { "type": "action", "action": "BattleReward" },
    "GameOver": { "type": "action", "action": "GameOver" },
    "CleanupBattle": {
      "type": "action",
      "action": "ClearBattleState"
    },

    "lobbyOperation": {
      "type": "weighted",
      "options": [
        {"node": "ChangeHero", "weight": 5},
        {"node": "ChangeShowHero", "weight": 5},
        {"node": "ChangeBackground", "weight": 5},
        {"node": "ChangeIcon", "weight": 5},
        {"node": "ChangeIframe", "weight": 5},
        {"node": "ChangeTitle", "weight": 5},
        {"node": "ChangeExpressShowHero", "weight": 5},
        {"node": "NewbieSignGetReward", "weight": 10},
        {"node": "GetDailyWinBoxReward", "weight": 15},
        {"node": "GetLevelReward", "weight": 10},
        {"node": "WorldChat", "weight": 10},
        {"node": "LookRankingList", "weight": 20}
      ]
    },
    "ChangeHero": { "type": "action", "action": "ChangeHero" },
    "ChangeShowHero": { "type": "action", "action": "ChangeShowHero" },
    "ChangeBackground": { "type": "action", "action": "ChangeBackground" },
    "ChangeIcon": { "type": "action", "action": "ChangeIcon" },
    "ChangeIframe": { "type": "action", "action": "ChangeIframe" },
    "ChangeTitle": { "type": "action", "action": "ChangeTitle" },
    "ChangeExpressShowHero": { "type": "action", "action": "ChangeExpressShowHero" },
    "NewbieSignGetReward": { "type": "action", "action": "NewbieSignGetReward" },
    "GetDailyWinBoxReward": { "type": "action", "action": "GetDailyWinBoxReward" },
    "GetLevelReward": { "type": "action", "action": "GetLevelReward" },
    "WorldChat": { "type": "action", "action": "WorldChat" },
    "LookRankingList": { "type": "action", "action": "LookRankingList" },

    "lottery": {
      "type": "sequence",
      "next": ["LotteryGetInfo", "LotterySelectUpHero", "LotteryLuckyDraw", "LotteryGetLog"]
    },
    "LotteryGetInfo": { "type": "action", "action": "LotteryGetInfo" },
    "LotterySelectUpHero": { "type": "action", "action": "LotterySelectUpHero" },
    "LotteryLuckyDraw": { "type": "action", "action": "LotteryLuckyDraw" },
    "LotteryGetLog": { "type": "action", "action": "LotteryGetLog" },

    "heroCultivate": {
      "type": "sequence",
      "next": ["HeroLevelUp", "HeroAwake", "HeroActivateTalent", "HeroEquipmentTalent"]
    },
    "HeroLevelUp": { "type": "action", "action": "HeroLevelUp" },
    "HeroAwake": { "type": "action", "action": "HeroAwake" },
    "HeroActivateTalent": { "type": "action", "action": "HeroActivateTalent" },
    "HeroEquipmentTalent": { "type": "action", "action": "HeroEquipmentTalent" },

    "shop": {
      "type": "sequence",
      "next": ["SystemShopOpen", "SystemShopBuy"]
    },
    "SystemShopOpen": { "type": "action", "action": "SystemShopOpen" },
    "SystemShopBuy": { "type": "action", "action": "SystemShopBuy" },

    "battlePass": {
      "type": "sequence",
      "next": ["UnlockAdvanced", "GetBattlePassReward", "BattlePassConversion"]
    },
    "UnlockAdvanced": { "type": "action", "action": "UnlockAdvanced" },
    "GetBattlePassReward": { "type": "action", "action": "GetBattlePassReward" },
    "BattlePassConversion": { "type": "action", "action": "BattlePassConversion" },

    "giftCode": { "type": "action", "action": "UseGiftCode" },

    "mail": {
      "type": "sequence",
      "next": ["GetMailList", "GetMailDetailData", "ReceiveMailAttachment", "DeleteMail"]
    },
    "GetMailList": { "type": "action", "action": "GetMailList" },
    "GetMailDetailData": { "type": "action", "action": "GetMailDetailData" },
    "ReceiveMailAttachment": { "type": "action", "action": "ReceiveMailAttachment" },
    "DeleteMail": { "type": "action", "action": "DeleteMail" },

    "friend": {
      "type": "sequence",
      "next": ["GetFriendList", "GetRecommendFriend", "RequestAddFriend", "GetRequestFriendList", "DisposeFriendRequest", "DelFriend"]
    },
    "GetFriendList": { "type": "action", "action": "GetFriendList" },
    "GetRecommendFriend": { "type": "action", "action": "GetRecommendFriend" },
    "RequestAddFriend": { "type": "action", "action": "RequestAddFriend" },
    "GetRequestFriendList": { "type": "action", "action": "GetRequestFriendList" },
    "DisposeFriendRequest": { "type": "action", "action": "DisposeFriendRequest" },
    "DelFriend": { "type": "action", "action": "DelFriend" }
  },

  "actions": {
    "RequestZoneList": {
      "pattern": "lua",
      "script": "request_zone_list.lua"
    },
    "RequestOutsideNotice": {
      "pattern": "lua",
      "script": "request_outside_notice.lua"
    },
    "RequestNotice": {
      "pattern": "lua",
      "script": "request_notice.lua"
    },
    "PostLogin": {
      "pattern": "lua",
      "script": "post_login.lua"
    },
    "NewRole": {
      "pattern": "lua",
      "script": "new_role.lua"
    },
    "SelectRole": {
      "pattern": "lua",
      "script": "select_role.lua"
    },
    "ConnectLogicTCP": {
      "pattern": "lua",
      "script": "connect_logic.lua"
    },
    "ConnectBattleTCP": {
      "pattern": "lua",
      "script": "connect_battle_tcp.lua"
    },
    "ConnectBattleUDP": {
      "pattern": "lua",
      "script": "connect_battle_udp.lua"
    },
    "RequestPlayerData": {
      "pattern": "lua",
      "script": "request_player_data.lua"
    },
    "PlayerLogin": {
      "pattern": "tcpRequest",
      "service": "logic",
      "route": {"cmd": 1, "act": 1},
      "c2sProto": "Game.LoginPlayerC2S",
      "s2cProto": "Game.LoginPlayerS2C",
      "bindings": [
        {"field": "playerId", "type": "state", "source": "roleId"},
        {"field": "session", "type": "state", "source": "session"},
        {"field": "version", "type": "state", "source": "version"},
        {"field": "battleVersion", "type": "state", "source": "battleVersion"},
        {"field": "account", "type": "state", "source": "account"},
        {"field": "zoneId", "type": "state", "source": "zoneId"}
      ],
      "store": [
        {"setter": "loginResp"}
      ]
    },
    "ReportBattleDelay": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 2, "act": 29},
      "c2sProto": "Game.MainBattleDelayC2S",
      "bindings": [
        {
          "field": "battleDelayList",
          "type": "nestedList",
          "items": [
            {
              "message": "Game.BattleDelay",
              "bindings": [
                {"field": "BattleArea", "type": "fixed", "value": "ap.hongkong"},
                {"field": "DelayTime", "type": "randomInt", "min": 30, "max": 100},
                {"field": "PingSendCnt", "type": "fixed", "value": 10},
                {"field": "PingRecvCnt", "type": "fixed", "value": 10}
              ]
            },
            {
              "message": "Game.BattleDelay",
              "bindings": [
                {"field": "BattleArea", "type": "fixed", "value": "ap.taibei"},
                {"field": "DelayTime", "type": "randomInt", "min": 30, "max": 100},
                {"field": "PingSendCnt", "type": "fixed", "value": 10},
                {"field": "PingRecvCnt", "type": "fixed", "value": 10}
              ]
            }
          ]
        }
      ]
    },
    "GetActivityList": {
      "pattern": "tcpRequest",
      "service": "logic",
      "route": {"cmd": 22, "act": 1},
      "c2sProto": "Game.OperateGetListC2S",
      "s2cProto": "Game.OperateGetListS2C"
    },
    "GMAddHero": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 9, "act": 1},
      "c2sProto": "Game.GmEventC2S",
      "bindings": [
        {
          "field": "GM",
          "type": "nested",
          "message": "Game.GMEvent",
          "bindings": [
            {"field": "type", "type": "fixed", "value": 4},
            {"field": "param", "type": "fixed", "value": [109,5,110,5,113,5,118,5,122,5,123,5,124,5,125,5,130,5,138,5,140,5,142,5,143,5,148,5,150,5,153,5,156,5,158,5,159,5,160,5]}
          ]
        }
      ]
    },
    "GMAddItem": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 9, "act": 1},
      "c2sProto": "Game.GmEventC2S",
      "bindings": [
        {
          "field": "GM",
          "type": "nested",
          "message": "Game.GMEvent",
          "bindings": [
            {"field": "type", "type": "fixed", "value": 4},
            {"field": "param", "type": "fixed", "value": [1,2147483647,2,2147483647,5,2147483647,6,2147483647,7,2147483647,8,2147483647,10,2147483647,14,2147483647,32,2147483647,33,2147483647,7200001,1,7200002,1,7200003,1,7200004,1,7300001,1,7300003,1,7300004,1,7300005,1,7300006,1,7090001,1,7090002,1,7090005,1,7110001,1,7110002,1,7110003,1,7110004,1,7110005,1,7110006,1,7110007,1,7110008,1,7110009,1,7120001,1,7120002,1,7120003,1,7120004,1,7120005,1,7040001,100000]}
          ]
        }
      ]
    },
    "GMAddHeroCup": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 9, "act": 1},
      "c2sProto": "Game.GmEventC2S",
      "bindings": [
        {
          "field": "GM",
          "type": "nested",
          "message": "Game.GMEvent",
          "bindings": [
            {"field": "type", "type": "fixed", "value": 13},
            {"field": "param", "type": "fixed", "value": [109, 1000]}
          ]
        }
      ]
    },
    "GMFinishAllNewUserGuide": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 9, "act": 1},
      "c2sProto": "Game.GmEventC2S",
      "bindings": [
        {
          "field": "GM",
          "type": "nested",
          "message": "Game.GMEvent",
          "bindings": [
            {"field": "type", "type": "fixed", "value": 52}
          ]
        }
      ]
    },
    "LbsPositioning": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 40, "act": 2},
      "c2sProto": "Game.LbsPositioningC2S",
      "bindings": [
        {"field": "lbsId", "type": "fixed", "value": 1}
      ]
    },
    "RequestGameModeList": {
      "pattern": "tcpRequest",
      "service": "logic",
      "route": {"cmd": 2, "act": 64},
      "c2sProto": "Game.MainGetGameModeListC2S",
      "s2cProto": "Game.MainGetGameModeListS2C",
      "store": [
        {"field": "gameModeMap", "setter": "gameModeMap"}
      ]
    },
    "CreateNormalTeam": {
      "pattern": "tcpRequest",
      "service": "logic",
      "route": {"cmd": 5, "act": 1},
      "c2sProto": "Game.TeamCreateC2S",
      "s2cProto": "Game.TeamCreateS2C",
      "bindings": [
        {"field": "model", "type": "fixed", "value": 5},
        {
          "field": "gameModelId",
          "type": "stateMapValue",
          "source": "gameModeMap",
          "path": "modeId",
          "required": true,
          "filters": [
            {"path": "modeId", "op": "neq", "value": 0},
            {"path": "DailyOpenTime", "op": "dailyTimeWindow"}
          ]
        }
      ],
      "store": [
        {"field": "teamId", "setter": "teamId"}
      ]
    },
    "SelectHero": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 5, "act": 14},
      "c2sProto": "Game.TeamChangeHeroC2S",
      "bindings": [
        {"type": "stateRandomN", "source": "heroIdList", "count": 3, "storeAs": "currentHeroIds"},
        {"field": "selectHeroes", "type": "state", "source": "currentHeroIds"},
        {"field": "selectSkins", "type": "state", "source": "currentHeroIds"}
      ]
    },
    "StartMatch": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 5, "act": 20},
      "c2sProto": "Game.TeamStartMatchC2S"
    },
    "MatchSucceed": {
      "pattern": "lua",
      "script": "match_succeed.lua"
    },
    "ListenStartLoading": {
      "pattern": "lua",
      "script": "listen_start_loading.lua"
    },
    "RegisterBattle": {
      "pattern": "lua",
      "script": "register_battle.lua"
    },
    "LoadProgress": {
      "pattern": "lua",
      "script": "load_progress.lua"
    },
    "BattleLoadOK": {
      "pattern": "tcpSend",
      "service": "battle",
      "route": {"cmd": 4, "act": 9},
      "c2sProto": "Game.BattleLoadOkC2S"
    },
    "ResetLoadState": {
      "pattern": "setState",
      "bindings": [
        {"field": "loadProgress", "type": "fixed", "value": 0},
        {"field": "packageIndex", "type": "fixed", "value": 0}
      ]
    },
    "StartGame": {
      "pattern": "tcpListen",
      "service": "battle",
      "route": {"cmd": 4, "act": 10},
      "s2cProto": "Game.BattleStartGameS2C",
      "timeout": 60
    },
    "SyncFrameData": {
      "pattern": "lua",
      "script": "sync_frame_data.lua"
    },
    "BattleEnd": {
      "pattern": "lua",
      "script": "battle_end.lua"
    },
    "BattleReward": {
      "pattern": "tcpListen",
      "service": "logic",
      "route": {"cmd": 4, "act": 72},
      "s2cProto": "Game.BattleRewardS2C",
      "timeout": 60,
      "optional": true
    },
    "GameOver": {
      "pattern": "tcpRequest",
      "service": "logic",
      "route": {"cmd": 2, "act": 62},
      "c2sProto": "Game.MainGameOverC2S",
      "s2cProto": "Game.MainGameOverS2C",
      "bindings": [
        {"field": "operation", "type": "fixed", "value": 0}
      ]
    },
    "ClearBattleState": {
      "pattern": "clearState",
      "keys": ["battleId", "battleAddress", "battleSecretKey", "battleSession", "fighterIndex", "fighterListData", "packageIndex", "battleAck"]
    },
    "ChangeHero": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 2, "act": 11},
      "c2sProto": "Game.MainChangeHeroC2S",
      "bindings": [
        {"field": "heroId", "type": "stateRandom", "source": "heroIdList"},
        {"field": "skinId", "type": "fixed", "value": 0}
      ]
    },
    "ChangeShowHero": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 2, "act": 68},
      "c2sProto": "Game.MainChangeShowHeroC2S",
      "bindings": [
        {"field": "heroId", "type": "stateRandom", "source": "heroIdList"},
        {"field": "skinId", "type": "fixed", "value": 0}
      ]
    },
    "ChangeBackground": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 2, "act": 14},
      "c2sProto": "Game.MainChangeBackgroundC2S",
      "bindings": [
        {"field": "id", "type": "randomPick", "values": [7120001, 7120002, 7120003, 7120004, 7120005]}
      ]
    },
    "ChangeIcon": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 2, "act": 12},
      "c2sProto": "Game.MainChangeIconC2S",
      "bindings": [
        {"field": "icon", "type": "randomPick", "values": [7200001, 7200002, 7200003, 7200004]}
      ]
    },
    "ChangeIframe": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 2, "act": 13},
      "c2sProto": "Game.MainChangeIframeC2S",
      "bindings": [
        {"field": "iFrame", "type": "randomPick", "values": [7300001, 7300003, 7300004, 7300005, 7300006]}
      ]
    },
    "ChangeTitle": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 2, "act": 49},
      "c2sProto": "Game.MainChangeTitleC2S",
      "bindings": [
        {"field": "id", "type": "randomPick", "values": [7090001, 7090002, 7090005]},
        {"field": "index", "type": "fixed", "value": 0}
      ]
    },
    "ChangeExpressShowHero": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {"cmd": 2, "act": 69},
      "c2sProto": "Game.MainChangeExpressShowHeroC2S",
      "bindings": [
        {"field": "heroId", "type": "stateRandom", "source": "heroIdList"}
      ]
