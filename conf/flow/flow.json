{
  "defaultDelayMs": 1000,
  "nodes": {
    "main": {
      "type": "sequence",
      "next": [
        "authLogin",
        "logicLogin",
        "checkNewRole",
        "businessLoop"
      ]
    },
    "authLogin": {
      "type": "sequence",
      "next": [
        "RequestZoneList",
        "RequestOutsideNotice",
        "RequestNotice",
        "PostLogin",
        "hasRole",
        "SelectRole"
      ]
    },
    "RequestZoneList": {
      "type": "action",
      "action": "RequestZoneList",
      "errorStrategy": "abort"
    },
    "RequestOutsideNotice": {
      "type": "action",
      "action": "RequestOutsideNotice"
    },
    "RequestNotice": {
      "type": "action",
      "action": "RequestNotice"
    },
    "PostLogin": {
      "type": "action",
      "action": "PostLogin",
      "errorStrategy": "abort"
    },
    "hasRole": {
      "type": "boolean",
      "condition": "lua:check_role.lua",
      "falseNext": "createNewRole"
    },
    "createNewRole": {
      "type": "action",
      "action": "NewRole",
      "errorStrategy": "abort"
    },
    "SelectRole": {
      "type": "action",
      "action": "SelectRole",
      "errorStrategy": "abort"
    },
    "logicLogin": {
      "type": "sequence",
      "next": [
        "ConnectLogicTCP",
        "PlayerLogin",
        "RequestPlayerData",
        "ReportBattleDelay"
      ]
    },
    "ConnectLogicTCP": {
      "type": "action",
      "action": "ConnectLogicTCP",
      "errorStrategy": "abort",
      "listenRefs": [
        {
          "route": {
            "cmd": 3,
            "act": 1
          },
          "server": "tcp:logic",
          "listen": "matchPoll"
        },
        {
          "route": {
            "cmd": 5,
            "act": 20
          },
          "server": "tcp:logic",
          "listen": "teamStartMatch"
        },
        {
          "route": {
            "cmd": 4,
            "act": 6
          },
          "server": "tcp:logic",
          "listen": "loadingPoll"
        },
        {
          "route": {
            "cmd": 4,
            "act": 72
          },
          "server": "tcp:logic",
          "listen": "rewardPoll"
        },
        {
          "route": {
            "cmd": 2,
            "act": 18
          },
          "server": "tcp:logic",
          "listen": "stateUpdate"
        },
        {
          "route": {
            "cmd": 6,
            "act": 1
          },
          "server": "tcp:logic",
          "listen": "heroUpdate"
        },
        {
          "route": {
            "cmd": 35,
            "act": 2
          },
          "server": "tcp:logic",
          "listen": "shopDataUpdate"
        },
        {
          "route": {
            "cmd": 35,
            "act": 3
          },
          "server": "tcp:logic",
          "listen": "shopLimitDataUpdate"
        },
        {
          "route": {
            "cmd": 5,
            "act": 3
          },
          "server": "tcp:logic",
          "listen": "teamUpdateInfo"
        },
        {
          "route": {
            "cmd": 5,
            "act": 6
          },
          "server": "tcp:logic",
          "listen": "teamNotifyInvite"
        },
        {
          "route": {
            "cmd": 5,
            "act": 10
          },
          "server": "tcp:logic",
          "listen": "teamJoin"
        },
        {
          "route": {
            "cmd": 14,
            "act": 10
          },
          "server": "tcp:logic",
          "listen": "roomUpdateData"
        },
        {
          "route": {
            "cmd": 14,
            "act": 23
          },
          "server": "tcp:logic",
          "listen": "roomUpdateStatus"
        }
      ]
    },
    "PlayerLogin": {
      "type": "action",
      "action": "PlayerLogin",
      "errorStrategy": "abort"
    },
    "RequestPlayerData": {
      "type": "action",
      "action": "RequestPlayerData",
      "errorStrategy": "abort"
    },
    "ReportBattleDelay": {
      "type": "action",
      "action": "ReportBattleDelay"
    },
    "gmCommands": {
      "type": "sequence",
      "next": [
        "GMAddHero",
        "GMAddItem",
        "GMAddHeroCup",
        "GMFinishAllNewUserGuide"
      ]
    },
    "GMAddHero": {
      "type": "action",
      "action": "GMAddHero"
    },
    "GMAddItem": {
      "type": "action",
      "action": "GMAddItem"
    },
    "GMAddHeroCup": {
      "type": "action",
      "action": "GMAddHeroCup"
    },
    "GMFinishAllNewUserGuide": {
      "type": "action",
      "action": "GMFinishAllNewUserGuide"
    },
    "businessLoop": {
      "type": "loop",
      "body": "rankedModel",
      "loopCount": -1
    },
    "SelectHero": {
      "type": "action",
      "action": "SelectHero"
    },
    "MatchSucceed": {
      "type": "action",
      "action": "MatchSucceed",
      "errorStrategy": "skip"
    },
    "ListenStartLoading": {
      "type": "action",
      "action": "ListenStartLoading",
      "errorStrategy": "skip"
    },
    "startBattle": {
      "type": "sequence",
      "next": [
        "ConnectBattleTCP",
        "ConnectBattleUDP",
        "RegisterBattle",
        "loadLoop",
        "BattleLoadOK",
        "ResetLoadState",
        "StartGame",
        "syncLoop",
        "BattleEnd",
        "BattleReward",
        "GameOver",
        "ClearBattleState"
      ]
    },
    "ConnectBattleTCP": {
      "type": "action",
      "action": "ConnectBattleTCP",
      "errorStrategy": "skip",
      "listenRefs": [
        {
          "route": {
            "cmd": 4,
            "act": 10
          },
          "server": "tcp:battle",
          "listen": "battleStartGame"
        }
      ]
    },
    "ConnectBattleUDP": {
      "type": "action",
      "action": "ConnectBattleUDP",
      "errorStrategy": "skip",
      "listenRefs": [
        {
          "route": {
            "cmd": 4,
            "act": 11
          },
          "server": "udp:battle",
          "listen": "frameData"
        }
      ]
    },
    "RegisterBattle": {
      "type": "action",
      "action": "RegisterBattle",
      "errorStrategy": "skip"
    },
    "loadLoop": {
      "type": "loop",
      "body": "LoadProgress",
      "loopCount": -1,
      "breakCondition": "state:loadProgress>=100"
    },
    "LoadProgress": {
      "type": "action",
      "action": "LoadProgress",
      "delayMs": -1
    },
    "BattleLoadOK": {
      "type": "action",
      "action": "BattleLoadOK"
    },
    "ResetLoadState": {
      "type": "action",
      "action": "ResetLoadState"
    },
    "StartGame": {
      "type": "action",
      "action": "StartGame"
    },
    "syncLoop": {
      "type": "loop",
      "body": "SyncFrameData",
      "loopCount": 50
    },
    "SyncFrameData": {
      "type": "action",
      "action": "SyncFrameData",
      "delayMs": -1
    },
    "BattleEnd": {
      "type": "action",
      "action": "BattleEnd"
    },
    "BattleReward": {
      "type": "action",
      "action": "BattleReward"
    },
    "GameOver": {
      "type": "action",
      "action": "GameOver"
    },
    "ClearBattleState": {
      "type": "action",
      "action": "ClearBattleState"
    },
    "checkNewRole": {
      "type": "boolean",
      "condition": "state:isNewRole == true",
      "trueNext": "initNewRole",
      "falseNext": "GetActivityList"
    },
    "initNewRole": {
      "type": "sequence",
      "next": [
        "gmCommands",
        "unlockBasicFunction",
        "LbsPositioning"
      ]
    },
    "unlockBasicFunction": {
      "type": "action",
      "description": "解锁排位等基础功能",
      "action": "unlockBasicFunction"
    },
    "ConfirmMatchSuccess": {
      "type": "action",
      "description": "确认匹配成功",
      "action": "ConfirmMatchSuccess",
      "errorStrategy": "skip"
    },
    "rankedModel": {
      "type": "sequence",
      "next": [
        "RankedTeamReset",
        "RankedTeamPrepare",
        "SelectHero",
        "rankedCanAttemptMatch",
        "rankedAfterMatchStart",
        "RankedTeamCleanup"
      ]
    },
    "rankedCanAttemptMatch": {
      "type": "boolean",
      "condition": "state:rankedRoundFailed",
      "falseNext": "rankedCanStartMatch"
    },
    "rankedCanStartMatch": {
      "type": "boolean",
      "condition": "state:rankedTeamRole!=member",
      "trueNext": "RankedStartMatch",
      "falseNext": "RankedMemberWaitMatch"
    },
    "rankedAfterMatchStart": {
      "type": "boolean",
      "condition": "state:rankedMatchStarted==true && !rankedRoundFailed",
      "trueNext": "rankedBattlePhase"
    },
    "rankedBattlePhase": {
      "type": "sequence",
      "next": [
        "MatchSucceed",
        "ConfirmMatchSuccess",
        "ListenStartLoading",
        "rankedCanEnterBattle"
      ]
    },
    "rankedCanEnterBattle": {
      "type": "boolean",
      "condition": "state:battleAddress && battleId && battleSecretKey && battleSession",
      "trueNext": "startBattle"
    },
    "RankedTeamReset": {
      "type": "action",
      "action": "RankedTeamReset",
      "errorStrategy": "skip"
    },
    "RankedTeamPrepare": {
      "type": "action",
      "action": "RankedTeamPrepare",
      "errorStrategy": "skip"
    },
    "RankedStartMatch": {
      "type": "action",
      "action": "RankedStartMatch",
      "errorStrategy": "skip"
    },
    "RankedMemberWaitMatch": {
      "type": "action",
      "action": "RankedMemberWaitMatch",
      "errorStrategy": "skip"
    },
    "RankedTeamCleanup": {
      "type": "action",
      "action": "RankedTeamCleanup"
    },
    "LbsPositioning": {
      "type": "action",
      "description": "Lbs定位",
      "action": "LbsPositioning"
    },
    "GetActivityList": {
      "type": "action",
      "action": "GetActivityList"
    }
  },
