{
  "defaultDelayMs": 1000,
  "nodes": {
    "main": {
      "type": "sequence",
      "next": [
        "authLogin",
        "logicLogin",
        "checkNewRole",
        "roleSplit"
      ]
    },
    "authLogin": {
      "type": "sequence",
      "next": [
        "RequestZoneList",
        "RequestOutsideNotice",
        "RequestNotice",
        "PostLogin",
        "hasRole",
        "SelectRole"
      ]
    },
    "RequestZoneList": {
      "type": "action",
      "action": "RequestZoneList",
      "onError": {
        "strategy": "abort"
      }
    },
    "RequestOutsideNotice": {
      "type": "action",
      "action": "RequestOutsideNotice"
    },
    "RequestNotice": {
      "type": "action",
      "action": "RequestNotice"
    },
    "PostLogin": {
      "type": "action",
      "action": "PostLogin",
      "onError": {
        "strategy": "abort"
      }
    },
    "hasRole": {
      "type": "boolean",
      "condition": "lua:check_role.lua",
      "falseNext": "createNewRole"
    },
    "createNewRole": {
      "type": "action",
      "action": "NewRole",
      "onError": {
        "strategy": "abort"
      }
    },
    "SelectRole": {
      "type": "action",
      "action": "SelectRole",
      "onError": {
        "strategy": "abort"
      }
    },
    "logicLogin": {
      "type": "sequence",
      "next": [
        "ConnectLogicTCP",
        "PlayerLogin",
        "RequestPlayerData",
        "ReportBattleDelay"
      ]
    },
    "ConnectLogicTCP": {
      "type": "action",
      "action": "ConnectLogicTCP",
      "onError": {
        "strategy": "abort"
      },
      "listenRefs": [
        {
          "route": {
            "cmd": 3,
            "act": 1
          },
          "server": "tcp:logic",
          "listen": "matchPoll"
        },
        {
          "route": {
            "cmd": 5,
            "act": 20
          },
          "server": "tcp:logic",
          "listen": "teamStartMatch"
        },
        {
          "route": {
            "cmd": 4,
            "act": 6
          },
          "server": "tcp:logic",
          "listen": "loadingPoll"
        },
        {
          "route": {
            "cmd": 4,
            "act": 72
          },
          "server": "tcp:logic",
          "listen": "rewardPoll"
        },
        {
          "route": {
            "cmd": 2,
            "act": 18
          },
          "server": "tcp:logic",
          "listen": "stateUpdate",
          "queueSize": 20
        },
        {
          "route": {
            "cmd": 35,
            "act": 2
          },
          "server": "tcp:logic",
          "listen": "shopDataUpdate"
        },
        {
          "route": {
            "cmd": 5,
            "act": 6
          },
          "server": "tcp:logic",
          "listen": "teamNotifyInvite"
        },
        {
          "route": {
            "cmd": 5,
            "act": 10
          },
          "server": "tcp:logic",
          "listen": "teamJoin"
        },
        {
          "route": {
            "cmd": 14,
            "act": 10
          },
          "server": "tcp:logic",
          "listen": "roomUpdateData"
        },
        {
          "route": {
            "cmd": 6,
            "act": 1
          },
          "server": "tcp:logic",
          "listen": "heroUpdate"
        }
      ]
    },
    "PlayerLogin": {
      "type": "action",
      "action": "PlayerLogin",
      "onError": {
        "strategy": "abort"
      }
    },
    "RequestPlayerData": {
      "type": "action",
      "action": "RequestPlayerData",
      "onError": {
        "strategy": "abort"
      }
    },
    "ReportBattleDelay": {
      "type": "action",
      "action": "ReportBattleDelay"
    },
    "checkNewRole": {
      "type": "boolean",
      "condition": "state:isNewRole",
      "trueNext": "initNewRole",
      "falseNext": "GetActivityList"
    },
    "initNewRole": {
      "type": "sequence",
      "next": [
        "gmCommands",
        "unlockBasicFunction",
        "LbsPositioning"
      ]
    },
    "gmCommands": {
      "type": "sequence",
      "next": [
        "GMAddHero",
        "GMAddItem",
        "GMAddHeroCup",
        "GMFinishAllNewUserGuide",
        "GMAddLadderLevel"
      ]
    },
    "GMAddHero": {
      "type": "action",
      "action": "GMAddHero"
    },
    "GMAddItem": {
      "type": "action",
      "action": "GMAddItem"
    },
    "GMAddHeroCup": {
      "type": "action",
      "action": "GMAddHeroCup"
    },
    "GMFinishAllNewUserGuide": {
      "type": "action",
      "action": "GMFinishAllNewUserGuide"
    },
    "GMAddLadderLevel": {
      "type": "action",
      "description": "GM 抬段位至大神榜门槛(星耀1=21)以上",
      "action": "GMAddLadderLevel"
    },
    "unlockBasicFunction": {
      "type": "action",
      "description": "解锁排位等基础功能",
      "action": "unlockBasicFunction"
    },
    "LbsPositioning": {
      "type": "action",
      "description": "Lbs定位",
      "action": "LbsPositioning"
    },
    "roleSplit": {
      "type": "boolean",
      "description": "对战和观战人数55分",
      "condition": "state:index % 2 == 0",
      "trueNext": "businessLoop",
      "falseNext": "wait_game_start"
    },
    "businessLoop": {
      "type": "loop",
      "description": "循环单排制造对局",
      "body": "ladder_wait",
      "loopCount": -1
    },
    "ladderModel": {
      "type": "sequence",
      "next": [
        "CreateLadderTeam",
        "StartMatch",
        "MatchSucceed",
        "ConfirmMatchSuccess",
        "ListenStartLoading",
        "startBattle"
      ]
    },
    "CreateLadderTeam": {
      "type": "action",
      "action": "CreateLadderTeam",
      "onError": {
        "strategy": "skip"
      }
    },
    "StartMatch": {
      "type": "action",
      "action": "StartMatch",
      "onError": {
        "strategy": "skip"
      }
    },
    "MatchSucceed": {
      "type": "action",
      "action": "MatchSucceed",
      "onError": {
        "strategy": "skip"
      }
    },
    "ConfirmMatchSuccess": {
      "type": "action",
      "description": "确认匹配成功",
      "action": "ConfirmMatchSuccess"
    },
    "ListenStartLoading": {
      "type": "action",
      "action": "ListenStartLoading",
      "onError": {
        "strategy": "skip"
      }
    },
    "startBattle": {
      "type": "sequence",
      "next": [
        "ConnectBattleTCP",
        "ConnectBattleUDP",
        "RegisterBattle",
        "loadLoop",
        "BattleLoadOK",
        "ResetLoadState",
        "StartGame",
        "syncLoop",
        "BattleEnd",
        "BattleReward",
        "GameOver",
        "CleanupBattle"
      ]
    },
    "ConnectBattleTCP": {
      "type": "action",
      "action": "ConnectBattleTCP",
      "onError": {
        "strategy": "skip"
      },
      "listenRefs": [
        {
          "route": {
            "cmd": 4,
            "act": 10
          },
          "server": "tcp:battle",
          "listen": "battleStartGame"
        }
      ]
    },
    "ConnectBattleUDP": {
      "type": "action",
      "action": "ConnectBattleUDP",
      "listenRefs": [
        {
          "route": {
            "cmd": 4,
            "act": 11
          },
          "server": "udp:battle",
          "listen": "frameData"
        }
      ]
    },
    "RegisterBattle": {
      "type": "action",
      "action": "RegisterBattle"
    },
    "loadLoop": {
      "type": "loop",
      "body": "LoadProgress",
      "loopCount": -1,
      "breakCondition": "state:loadProgress>=100"
    },
    "LoadProgress": {
      "type": "action",
      "action": "LoadProgress",
      "delayMs": -1
    },
    "BattleLoadOK": {
      "type": "action",
      "action": "BattleLoadOK"
    },
    "ResetLoadState": {
      "type": "action",
      "action": "ResetLoadState"
    },
    "StartGame": {
      "type": "action",
      "action": "StartGame"
    },
    "syncLoop": {
      "type": "loop",
      "description": "战斗帧同步，保证在战窗口供观战",
      "body": "SyncFrameData",
      "loopCount": 3000
    },
    "SyncFrameData": {
      "type": "action",
      "action": "SyncFrameData",
      "delayMs": -1
    },
    "BattleEnd": {
      "type": "action",
      "action": "BattleEnd"
    },
    "BattleReward": {
      "type": "action",
      "action": "BattleReward"
    },
    "GameOver": {
      "type": "action",
      "action": "GameOver"
    },
    "CleanupBattle": {
      "type": "action",
      "action": "ClearBattleState"
    },
    "watchLoop": {
      "type": "loop",
      "description": "观战者：循环拉榜→取址→连 ob→观战",
      "body": "ob_wait",
      "loopCount": -1
    },
    "watchRound": {
      "type": "sequence",
      "next": [
        "ObBattleList",
        "pickTarget",
        "hasTarget",
        "closeStaleOb"
      ]
    },
    "closeStaleOb": {
      "type": "action",
      "description": "关闭上一轮残留的观战服连接",
      "action": "CloseObserver"
    },
    "ObBattleList": {
      "type": "action",
      "action": "ObBattleList",
      "onError": {
        "strategy": "skip"
      }
    },
    "pickTarget": {
      "type": "action",
      "action": "PickObTarget"
    },
    "hasTarget": {
      "type": "boolean",
      "condition": "state:obHasTarget == 1",
      "trueNext": "fetchAddress"
    },
    "fetchAddress": {
      "type": "sequence",
      "next": [
        "ObRoomAddress",
        "connectOb",
        "enterRoom",
        "watchLoading",
        "resetObWatch",
        "watchEnd"
      ]
    },
    "ObRoomAddress": {
      "type": "action",
      "description": "取观战房地址",
      "action": "ObRoomAddress",
      "onError": {
        "strategy": "skip"
      }
    },
    "connectOb": {
      "type": "action",
      "description": "连观战服 + 密钥握手",
      "action": "ConnectObserver",
      "onError": {
        "strategy": "skip"
      },
      "listenRefs": [
        {
          "route": {
            "cmd": 31,
            "act": 4
          },
          "server": "tcp:ob",
          "listen": "obLoading"
        },
        {
          "route": {
            "cmd": 32,
            "act": 1
          },
          "server": "tcp:ob",
          "listen": "obFrame"
        },
        {
          "route": {
            "cmd": 32,
            "act": 2
          },
          "server": "tcp:ob",
          "listen": "obBattleEnd"
        }
      ]
    },
    "enterRoom": {
      "type": "action",
      "description": "进观战房",
      "action": "ObEnterRoom",
      "onError": {
        "strategy": "skip"
      }
    },
    "watchLoading": {
      "type": "action",
      "description": "收加载数据",
      "action": "WatchObLoading",
      "onError": {
        "strategy": "skip"
      }
    },
    "watchEnd": {
      "type": "loop",
      "description": "观战：跑满自决帧数(loopCount) 或 收到战斗结束(32:2)",
      "body": "WatchObTick",
      "loopCount": 2000,
      "breakCondition": "state:obBattleEnded == 1"
    },
    "resetObWatch": {
      "type": "action",
      "description": "每轮观战前复位结束标志",
      "action": "ResetObWatch"
    },
    "WatchObTick": {
      "type": "action",
      "description": "观战单帧轮询：非阻塞探 32:2 战斗结束",
      "action": "WatchObTick",
      "delayMs": -1
    },
    "GetActivityList": {
      "type": "action",
      "action": "GetActivityList"
    },
    "ob_wait": {
      "type": "wait",
      "description": "等待战斗组匹配成功",
      "waitMin": 5000,
      "waitMax": 60000,
      "then": "watchRound"
    },
    "ladder_wait": {
      "type": "wait",
      "description": "随机等待错开时间匹配",
      "waitMin": 500,
      "waitMax": 30000,
      "then": "ladderModel"
    },
    "wait_game_start": {
      "type": "wait",
      "description": "等待第一轮匹配",
      "waitMs": 180000,
      "then": "watchLoop"
    }
  },
  "actions": {
    "RequestZoneList": {
      "pattern": "lua",
      "script": "request_zone_list.lua"
    },
    "RequestOutsideNotice": {
      "pattern": "lua",
      "script": "request_outside_notice.lua"
    },
    "RequestNotice": {
      "pattern": "lua",
      "script": "request_notice.lua"
    },
    "PostLogin": {
      "pattern": "lua",
      "script": "post_login.lua"
    },
    "NewRole": {
      "pattern": "lua",
      "script": "new_role.lua"
    },
    "SelectRole": {
      "pattern": "lua",
      "script": "select_role.lua"
    },
    "ConnectLogicTCP": {
      "pattern": "lua",
      "script": "connect_logic.lua"
    },
    "ConnectBattleTCP": {
      "pattern": "lua",
      "script": "connect_battle_tcp.lua"
    },
    "ConnectBattleUDP": {
      "pattern": "lua",
      "script": "connect_battle_udp.lua"
    },
    "RequestPlayerData": {
      "pattern": "lua",
      "script": "request_player_data.lua"
    },
    "PlayerLogin": {
      "pattern": "tcpRequest",
      "service": "logic",
      "route": {
        "cmd": 1,
        "act": 1
      },
      "c2sProto": "Game.LoginPlayerC2S",
      "s2cProto": "Game.LoginPlayerS2C",
      "bindings": [
        {
          "type": "state",
          "field": "playerId",
          "source": "roleId"
        },
        {
          "type": "state",
          "field": "session",
          "source": "session"
        },
        {
          "type": "state",
          "field": "version",
          "source": "version"
        },
        {
          "type": "state",
          "field": "battleVersion",
          "source": "battleVersion"
        },
        {
          "type": "state",
          "field": "account",
          "source": "account"
        },
        {
          "type": "state",
          "field": "zoneId",
          "source": "zoneId"
        }
      ],
      "store": [
        {
          "setter": "loginResp"
        }
      ]
    },
    "ReportBattleDelay": {
      "pattern": "tcpSend",
      "service": "logic",
      "route": {
        "cmd": 2,
        "act": 29
      },
      "c2sProto": "Game.MainBattleDelayC2S",
      "bindings": [
        {
          "type": "fixed",
          "field": "battleDelayList[0].BattleArea",
          "value": "ap.hongkong"
        },
        {
          "type": "randomInt",
          "field": "battleDelayList[0].DelayTime",
          "min": 30,
          "max": 100
        },
        {
          "type": "fixed",
          "field": "battleDelayList[0].PingSendCnt",
          "value": 10
        },
        {
          "type": "fixed",
          "field": "battleDelayList[0].PingRecvCnt",
          "value": 10
        },
        {
          "type": "fixed",
          "field": "battleDelayList[1].BattleArea",
          "value": "ap.taibei"
        },
        {
          "type": "randomInt",
          "field": "battleDelayList[1].DelayTime",
          "min": 30,
          "max": 100
        },
        {
          "type": "fixed",
          "field": "battleDelayList[1].PingSendCnt",
          "value": 10
        },
        {
          "type": "fixed",
          "field": "battleDelayList[1].PingRecvCnt",
          "value": 10
        }
      ]
    },
