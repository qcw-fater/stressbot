[program:stressbot-admin]
command=/opt/stressbot/admin -config /etc/stressbot/admin-config.json
directory=/opt/stressbot
user=stressbot
autostart=true
autorestart=unexpected
exitcodes=0
startsecs=5
# 数据库迁移连续失败三次后进入 FATAL；人工排障并执行 -migration status/up 后再手工启动。
startretries=3
stopsignal=TERM
stopwaitsecs=20
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/stressbot/admin-supervisor.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=5
