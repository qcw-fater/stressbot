stressbot.example.com {
	encode zstd gzip

	# 内部 Agent 上行路由永远不从浏览器管理入口转发。
	@sbot_agent path /sbot/agent/*
	respond @sbot_agent 404

	# oauth2-proxy、Authelia 或企业 IAP 均可提供此认证检查端点。
	forward_auth 127.0.0.1:4180 {
		uri /oauth2/auth
		copy_headers X-Auth-Request-User X-Auth-Request-Email Authorization
	}

	reverse_proxy 127.0.0.1:7718
}
