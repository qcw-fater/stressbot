{
  "nodes": {
    "main": {
      "type": "sequence",
      "next": ["connect", "login", "fetchPlayer", "idle", "close"]
    },
    "connect":     { "type": "action", "action": "ConnectArena" },
    "login":       { "type": "action", "action": "LoginArena" },
    "fetchPlayer": { "type": "action", "action": "FetchPlayer" },
    "close":       { "type": "action", "action": "CloseArena" },

    "idle": {
      "type": "loop",
      "loopCount": -1,
      "body": "battleRound",
      "breakCondition": "state:stamina < 10"
    },
    "battleRound": {
      "type": "sequence",
      "next": ["chooseStage", "startBattle", "afterBattle", "rest"]
    },

    "chooseStage": {
      "type": "boolean",
      "condition": "state:level >= 10",
      "trueNext": "pickHardStage",
      "falseNext": "pickEasyStage"
    },
    "pickHardStage": { "type": "action", "action": "PickHardStage" },
    "pickEasyStage": { "type": "action", "action": "PickEasyStage" },

    "startBattle": { "type": "action", "action": "StartBattle" },

    "afterBattle": {
      "type": "switch",
      "cases": [
        { "condition": "state:lastWin == 1", "next": "celebrate" },
        { "condition": "state:lastWin == 0", "next": "mourn" }
      ]
    },
    "celebrate": { "type": "action", "action": "Celebrate" },
    "mourn":     { "type": "action", "action": "Mourn" },

    "rest": {
      "type": "weighted",
      "options": [
        { "node": "doChat", "weight": 3 },
        { "node": "doIdle", "weight": 7 }
      ]
    },
    "doChat": { "type": "action", "action": "Chat" },
    "doIdle": { "type": "wait", "waitMin": 200, "waitMax": 800 }
  },
  "actions": {
    "ConnectArena": {
      "pattern": "tcpConnect",
      "service": "arena",
      "address": "state:arenaAddr"
    },
    "LoginArena": {
      "pattern": "tcpRequest",
      "service": "arena",
      "route": { "cmd": 100, "act": 1 },
      "c2sProto": "arena.LoginAccountC2S",
      "bindings": [
        { "field": "account", "type": "state", "source": "account" },
        { "field": "version", "type": "fixed", "value": "0.31.49" }
      ],
      "s2cProto": "arena.LoginAccountS2C",
      "store": [
        { "field": "playerId", "setter": "playerId" }
      ],
      "timeout": 5
    },
    "FetchPlayer": {
      "pattern": "tcpRequest",
      "service": "arena",
      "route": { "cmd": 100, "act": 2 },
      "c2sProto": "arena.FetchPlayerC2S",
      "bindings": [
        { "field": "playerId", "type": "state", "source": "playerId" }
      ],
      "s2cProto": "arena.FetchPlayerS2C",
      "store": [
        { "setter": "playerData" },
        { "field": "level", "setter": "level" },
        { "field": "stamina", "setter": "stamina" }
      ],
      "timeout": 5
    },
    "PickHardStage": {
      "pattern": "setState",
      "bindings": [ { "field": "stageId", "type": "fixed", "value": 2 } ]
    },
    "PickEasyStage": {
      "pattern": "setState",
      "bindings": [ { "field": "stageId", "type": "fixed", "value": 1 } ]
    },
    "StartBattle": {
      "pattern": "tcpRequest",
      "service": "arena",
      "route": { "cmd": 200, "act": 1 },
      "c2sProto": "arena.BattleStartC2S",
      "bindings": [
        { "field": "stageId", "type": "state", "source": "stageId" }
      ],
      "s2cProto": "arena.BattleResultS2C",
      "store": [
        { "field": "win", "setter": "lastWin" },
        { "field": "staminaLeft", "setter": "stamina" },
        { "field": "coinsGained", "setter": "lastGain" }
      ],
      "timeout": 10
    },
    "Celebrate": {
      "pattern": "setState",
      "bindings": [ { "field": "mood", "type": "fixed", "value": "happy" } ]
    },
    "Mourn": {
      "pattern": "setState",
      "bindings": [ { "field": "mood", "type": "fixed", "value": "sad" } ]
    },
    "Chat": {
      "pattern": "setState",
      "bindings": [ { "field": "lastChatAt", "type": "fixed", "value": "gl" } ]
    },
    "CloseArena": {
      "pattern": "tcpClose",
      "service": "arena"
    }
  }
}
