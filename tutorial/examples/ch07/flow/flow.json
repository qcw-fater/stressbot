{
  "nodes": {
    "main": {
      "type": "sequence",
      "next": ["connect", "login", "fetchPlayer", "browseShop", "buyCheap", "shout", "report", "close"]
    },
    "connect":     { "type": "action", "action": "ConnectArena" },
    "login":       { "type": "action", "action": "LoginArena" },
    "fetchPlayer": { "type": "action", "action": "FetchPlayer" },
    "browseShop":  { "type": "action", "action": "BrowseShop" },
    "buyCheap":    { "type": "action", "action": "BuyCheapItem" },
    "shout":       { "type": "action", "action": "Shout" },
    "report":      { "type": "action", "action": "ReportStats" },
    "close":       { "type": "action", "action": "CloseArena" }
  },
  "actions": {
    "ConnectArena": {
      "pattern": "tcpConnect",
      "service": "arena",
      "address": "state:arenaAddr"
    },
    "LoginArena": {
      "pattern": "tcpRequest",
      "service": "arena",
      "route": { "cmd": 100, "act": 1 },
      "c2sProto": "arena.LoginAccountC2S",
      "bindings": [
        { "field": "account", "type": "state", "source": "account" },
        { "field": "version", "type": "fixed", "value": "0.31.49" }
      ],
      "s2cProto": "arena.LoginAccountS2C",
      "store": [ { "field": "playerId", "setter": "playerId" } ],
      "timeout": 5
    },
    "FetchPlayer": {
      "pattern": "tcpRequest",
      "service": "arena",
      "route": { "cmd": 100, "act": 2 },
      "c2sProto": "arena.FetchPlayerC2S",
      "bindings": [ { "field": "playerId", "type": "state", "source": "playerId" } ],
      "s2cProto": "arena.FetchPlayerS2C",
      "store": [ { "setter": "playerData" } ],
      "timeout": 5
    },
    "BrowseShop": {
      "pattern": "tcpRequest",
      "service": "arena",
      "route": { "cmd": 500, "act": 1 },
      "c2sProto": "arena.ShopListC2S",
      "bindings": [ { "field": "category", "type": "fixed", "value": 0 } ],
      "s2cProto": "arena.ShopListS2C",
      "store": [ { "field": "items", "setter": "shopItems" } ],
      "timeout": 5
    },
    "BuyCheapItem": {
      "pattern": "tcpRequest",
      "service": "arena",
      "route": { "cmd": 500, "act": 2 },
      "c2sProto": "arena.BuyItemC2S",
      "bindings": [
        {
          "field": "itemId",
          "type": "stateRandom",
          "source": "shopItems",
          "path": "itemId",
          "filters": [
            { "path": "price", "op": "lt", "value": 100 },
            { "path": "stock", "op": "gt", "value": 0 }
          ]
        },
        { "field": "count", "type": "randomInt", "min": 1, "max": 3 }
      ],
      "s2cProto": "arena.BuyItemS2C",
      "store": [ { "field": "orderId", "setter": "lastOrderId" } ],
      "timeout": 5
    },
    "Shout": {
      "pattern": "tcpRequest",
      "service": "arena",
      "route": { "cmd": 300, "act": 1 },
      "c2sProto": "arena.ChatC2S",
      "bindings": [
        { "field": "text", "type": "randomString", "length": 8, "charset": "lower" },
        { "field": "channel", "type": "randomPick", "values": [1, 2, 3] }
      ],
      "s2cProto": "arena.ChatS2C",
      "timeout": 5
    },
    "ReportStats": {
      "pattern": "tcpRequest",
      "service": "arena",
      "route": { "cmd": 600, "act": 1 },
      "c2sProto": "arena.ReportStatsC2S",
      "bindings": [
        {
          "field": "tags",
          "type": "map",
          "entries": [
            { "key": 1, "value": { "type": "fixed", "value": "tutorial" } },
            { "key": 2, "value": { "type": "randomString", "length": 4, "charset": "numeric" } }
          ]
        }
      ],
      "s2cProto": "arena.ReportStatsS2C",
      "timeout": 5
    },
    "CloseArena": {
      "pattern": "tcpClose",
      "service": "arena"
    }
  }
}
