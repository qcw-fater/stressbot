@startuml ch03-request-journey
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
title 一次 tcpRequest 的完整旅程（使用者视角）

participant "流程引擎\n(Executor)" as exec
participant "动作执行器\n(ActionExecutor)" as ae
participant "codec\n(tcp_<service>_codec.json)" as codec
participant "连接\n(service 名下)" as conn
participant "目标服务器" as srv
database "机器人状态\n(state)" as st

exec -> ae : 走到 action 节点，取动作定义
ae -> st : 按 bindings 取值\n(fixed / state / randomInt ...)
ae -> ae : 按 c2sProto 组装并序列化请求体
ae -> codec : 编码协议头（路由字段、长度、加密/压缩）
ae -> conn : 登记「等待路由键 R」并发送
conn -> srv : TCP 写出（写完成时刻 = RTT 起点）
alt 在超时时间内收到路由键为 R 的帧
  srv --> conn : 响应帧（可读时刻 = RTT 终点）
  conn -> codec : 解码协议头，取出路由键与 body
  conn --> ae : 投递给等待者
  alt 协议头错误码字段非 0
    ae --> exec : 失败（业务错误码，onError 链路）
  else 正常
    ae -> ae : 按 s2cProto 校验响应
    ae -> st : 按 store 映射写入状态
    ae --> exec : 成功
  end
else 超时 / 连接断开 / 被取消
  ae --> exec : 超时(码 4) / 失败(如码 2) / 取消(码 6)\n进入 onError 链路
end
exec -> exec : 记录监控样本\n协作式等待节点间隔，进入下一个节点
@enduml
