# stressbot 前端环境变量
#
# Vite 加载优先级（后者覆盖前者）：
#   .env → .env.local → .env.[mode] → .env.[mode].local
#   mode = development (npm run dev) / production (npm run build)
#
# .env.production    — 生产默认值（提交到 git，CI/CD 直接用）
# .env.development   — 开发默认值（可选，提交到 git）
# .env.local         — 个人覆盖（git 忽略，不提交）
# .env.development.local — 开发个人覆盖（git 忽略）
# .env.production.local  — 生产个人覆盖（git 忽略）

# Admin API 前缀（默认 /sbot）
# VITE_API_PREFIX=/sbot

# 基线资源前缀（默认 /sbot/baseline）
# VITE_BASELINE_PREFIX=/sbot/baseline

# ── RobotConfig 默认值（创建任务表单的初始值） ──
# 不配置则使用内置默认值；配置后覆盖对应字段

# VITE_ROBOT_ACCOUNT_PREFIX=bot_
# VITE_ROBOT_MAIN_SERVICE=logic
# VITE_ROBOT_CONCURRENCY=50
# VITE_ROBOT_TIMEOUT_SEC=60
# VITE_ROBOT_HEARTBEAT_SEC=5
# VITE_ROBOT_HTTP_TIMEOUT_SEC=10
# VITE_ROBOT_APDEX_T=100
# VITE_ROBOT_START_NUMBER=0
# VITE_ROBOT_LOG_LEVEL=info
